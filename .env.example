# Database (postgres container port is 5432 inside Docker; mapped to 5433 on host to avoid conflicts)
ConnectionStrings__Default=Host=postgres;Database=mediaportfolio;Username=postgres;Password=postgres

# JWT Auth
Jwt__SigningKey=ReplaceThisWithATrulyLongAndSecureSecretKeyThatIsAtLeast32Bytes
Jwt__AccessTokenLifetimeMinutes=60
Jwt__RefreshTokenLifetimeDays=7

# Initial Admin Seeding
AdminSeed__InitialPassword=[PASSWORD]

# Media Storage
MediaStorage__Provider=Local  # or Cloudflare

# Background Jobs
Hangfire__Enabled=true

# Cloudflare (Stream & Images)
Cloudflare__StreamApiToken=
Cloudflare__StreamAccountId=
Cloudflare__ImagesApiToken=
Cloudflare__ImagesAccountId=

Turnstile__SecretKey=[YOUR_TURNSTILE_SECRET_KEY]

# Email (SendGrid or similar)
Email__ApiKey=
Email__FromAddress=no-reply@sainin.com

# CORS
Cors__AllowedOrigin=http://localhost:3000
